# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/firedup_coffee?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/firedup_coffee?retryWrites=true&w=majority
DB_NAME=firedup_coffee

# Client Frontend URL (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# JWT & Authentication Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_key

# Admin Provisioning Security (Mandatory Invitation Token for Staff)
ADMIN_INVITATION_SECRET=replace_with_a_secure_invitation_secret

# Initial Admin Provisioning Placeholders (used by provision:admin script)
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace_with_secure_initial_admin_password

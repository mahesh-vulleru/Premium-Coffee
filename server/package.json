{
  "name": "firedup-coffee-server",
  "version": "1.0.0",
  "description": "Backend API for Firedup Specialty Coffee using Express, TypeScript, and MongoDB Atlas",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:products": "tsx src/scripts/seed-products.ts",
    "provision:admin": "tsx src/scripts/provision-admin.ts",
    "test": "tsx test-connection.ts",
    "test:isolation": "tsx test-auth-isolation.ts",
    "lint": "oxlint"
  },
  "keywords": [
    "firedup",
    "coffee",
    "express",
    "typescript",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
